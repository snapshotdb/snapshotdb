[Unit]
Description=SnapshotDB BYOC database branching server
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/snapshotdb
ConditionPathExists=/etc/snapshotdb.env

[Service]
Type=simple
User=snapshotdb
Group=snapshotdb
EnvironmentFile=/etc/snapshotdb.env
Environment=USER=snapshotdb
Environment=PATH=/usr/lib/postgresql/16/bin:/usr/local/bin:/usr/sbin:/usr/bin:/bin
ExecStart=/usr/local/bin/snapshotdb serve --bind 127.0.0.1:7432 --db-bind 127.0.0.1 --public-host 127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
KillMode=mixed
TimeoutStopSec=120
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
