[Unit]
Description=SnapshotDB database branching server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snapshotdb
Group=snapshotdb
EnvironmentFile=/etc/snapshotdb.env
Environment=SNAPSHOTDB_HOME=/srv/snapshotdb
Environment=USER=snapshotdb
ExecStart=/usr/local/bin/snapshotdb serve --bind 127.0.0.1:7432 --db-bind 0.0.0.0 --public-host branches.internal
Restart=on-failure
RestartSec=5
UMask=0077
KillMode=mixed
TimeoutStopSec=120
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
