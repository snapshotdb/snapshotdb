[Unit]
Description=SnapshotDB retained database and full regression checks after the 1 TB benchmark
After=snapshotdb-benchmark-1tb.service snapshotdb-tb.service
RequiresMountsFor=/srv/snapshotdb-tb /srv/snapshotdb-data

[Service]
Type=exec
ExecStart=/usr/bin/python3 /usr/local/lib/snapshotdb-post-benchmark.py
ExecStopPost=/usr/bin/python3 /usr/local/lib/snapshotdb-post-benchmark-finish.py
Restart=no
UMask=0077
KillMode=control-group
TimeoutStopSec=120
RuntimeMaxSec=21600
