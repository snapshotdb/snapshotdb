# snapshotdb console — environment
# Copy to .env.local and fill in for GitHub sign-in.

# Secret used to sign the console session cookie (HMAC). Use a long random string.
#   openssl rand -base64 48
AUTH_SECRET=

# GitHub OAuth app credentials.
# Create an OAuth app at https://github.com/settings/developers
#   Authorization callback URL: https://YOUR_DOMAIN/api/auth/github/callback
#   (for local dev: http://localhost:3000/api/auth/github/callback)
# When these are unset, the console shows an "Enter demo console" button instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Hosted gateway (server-only: never prefix these with NEXT_PUBLIC_).
SNAPSHOTDB_HOSTED_API=https://api.snapshotdb.io
# Separate from the BYOC/admin SNAPSHOTDB_TOKEN. Set the same secret on the API server.
SNAPSHOTDB_HOSTED_TOKEN=

# Dodo Payments: Pro is a $150 USD monthly recurring product (no trial).
DODO_PAYMENTS_API_KEY=
# test_mode or live_mode; the API key only works in its own mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRO_PRODUCT_ID=
# Webhook endpoint secret (whsec_...). Endpoint: https://www.snapshotdb.io/api/billing/webhook
# Events: subscription.active, subscription.renewed, subscription.cancelled,
#         subscription.failed, subscription.expired
DODO_WEBHOOK_SECRET=
