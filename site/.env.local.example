# snapshotdb console — environment
# Copy to .env.local and fill in for GitHub sign-in.

# Secret used to sign the console session cookie (HMAC). Use a long random string.
#   openssl rand -base64 48
AUTH_SECRET=

# GitHub OAuth app credentials.
# Create an OAuth app at https://github.com/settings/developers
#   Authorization callback URL: https://YOUR_DOMAIN/api/auth/github/callback
#   (for local dev: http://localhost:3000/api/auth/github/callback)
# When these are unset, the console shows an "Enter demo console" button instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
